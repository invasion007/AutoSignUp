{
  "name": "auto-sign-up",
  "version": "1.0.0",
  "description": "Google 账号自动注册工具 - 使用 Playwright 自动化注册流程",
  "type": "module",
  "scripts": {
    "signup": "node scripts/google-signup.mjs",
    "signup:headless": "HEADLESS=true node scripts/google-signup.mjs",
    "signup:proxy": "node scripts/google-register-with-proxy.mjs",
    "signup:proxy:headless": "HEADLESS=true node scripts/google-register-with-proxy.mjs",
    "find-proxy": "node scripts/find-residential-proxy.mjs",
    "chatgpt-signup": "node scripts/chatgpt-signup.mjs",
    "chatgpt-signup:headless": "HEADLESS=true node scripts/chatgpt-signup.mjs"
  },
  "dependencies": {
    "@mr_ozio/playwright-stealth": "^1.0.0",
    "playwright": "^1.52.0"
  },
  "keywords": [
    "google",
    "signup",
    "automation",
    "playwright",
    "accessibility"
  ],
  "license": "MIT"
}
